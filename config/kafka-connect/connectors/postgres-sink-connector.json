{
  "name": "streamforge-postgres-jdbc-sink",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "2",
    "topics": "streamforge.user.activity",
    "connection.url": "jdbc:postgresql://postgres:5432/streamforge",
    "connection.user": "postgres",
    "connection.password": "postgres",
    "table.name.format": "processed_events_connect",
    "auto.create": "true",
    "auto.evolve": "true",
    "insert.mode": "upsert",
    "pk.mode": "record_key",
    "pk.fields": "event_id",
    "batch.size": "1000",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "http://schema-registry:8081"
  }
}

