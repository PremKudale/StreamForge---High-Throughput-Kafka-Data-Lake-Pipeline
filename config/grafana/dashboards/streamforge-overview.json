          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "rate(streamforge_lake_sink_events_total[1m])",
          "legendFormat": "Parquet Events/sec"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "id": 5,
      "title": "Dead Letter Queue (DLQ) Failure & Replay Rate",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(streamforge_consumer_events_errors_total[1m]))",
          "legendFormat": "DLQ Diverted Events/sec"
        }
      ]
    }
