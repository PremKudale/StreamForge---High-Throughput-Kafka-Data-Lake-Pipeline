      "title": "Ingestion Throughput (Events/sec)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(streamforge_producer_events_total[1m])) by (event_type)",
